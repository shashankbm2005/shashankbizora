# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Backend Only):
# Found in Supabase Project Settings -> API
# Keep SUPABASE_SERVICE_ROLE_KEY confidential on the server; NEVER expose in browser.
SUPABASE_URL="https://qfhdnsfcqjjrfwnregrt.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_publishable_Z92AffcEwzHYE1WrSo5aHg_s850f3pY"

# BIZORA ADMIN AUTHENTICATION:
# Secure password used by the founder to log into /admin dashboard.
# Defaults to a secure generated key or your chosen password.
ADMIN_PASSWORD="YourSecureAdminPasswordHere"
ADMIN_SESSION_SECRET="random-32-byte-hex-string-for-signing-session-tokens"

